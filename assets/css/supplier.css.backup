body.supplier-dashboard-page { background: var(--blue-50); }
.supplier-topbar { color: var(--white); background: var(--navy-900); }
.supplier-topbar-inner { display: flex; min-height: 72px; align-items: center; justify-content: space-between; }
.supplier-top-actions { display: flex; gap: 22px; color: #c9d8eb; font-size: 13px; }
.supplier-shell { display: grid; grid-template-columns: 235px 1fr; gap: 25px; padding-top: 25px; padding-bottom: 70px; }
.supplier-sidebar { align-self: start; padding: 18px 14px; background: var(--white); border: 1px solid var(--border); }
.supplier-profile { display: flex; align-items: center; gap: 10px; padding: 0 6px 18px; border-bottom: 1px solid var(--border); }
.supplier-profile-avatar { display: grid; width: 38px; height: 38px; place-items: center; color: var(--navy-700); background: var(--blue-100); border-radius: 5px; font-weight: 700; }
.supplier-profile strong, .supplier-profile small { display: block; max-width: 145px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.supplier-profile strong { color: var(--navy-950); font-size: 12px; }
.supplier-profile small { margin-top: 3px; color: #16805b; font-size: 10px; }
.supplier-sidebar nav p { margin: 20px 7px 7px; color: #94a3b8; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
.supplier-sidebar nav a { display: flex; align-items: center; justify-content: space-between; padding: 10px 8px; color: var(--muted); border-radius: 3px; font-size: 13px; }
.supplier-sidebar nav a:hover, .supplier-sidebar nav a.supplier-nav-active { color: var(--navy-700); background: var(--blue-100); font-weight: 700; }
.nav-count { min-width: 19px; padding: 2px 5px; color: var(--white); background: var(--navy-700); border-radius: 10px; text-align: center; font-size: 10px; }
.supplier-breadcrumb { margin-bottom: 20px; color: var(--muted); font-size: 12px; }
.supplier-breadcrumb span { margin: 0 8px; }
.supplier-welcome { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 25px; }
.supplier-welcome h1 { margin: 0 0 5px; color: var(--navy-950); font-size: 32px; }
.supplier-welcome p:not(.eyebrow) { margin: 0; color: var(--muted); }
.supplier-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 13px; margin-bottom: 18px; }
.supplier-kpis article { padding: 17px; background: var(--white); border: 1px solid var(--border); border-top: 3px solid var(--navy-700); }
.supplier-kpis span, .supplier-kpis small { display: block; color: var(--muted); font-size: 11px; }
.supplier-kpis strong { display: block; margin: 6px 0 2px; color: var(--navy-950); font-size: 23px; }
.supplier-action-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 13px; margin-bottom: 20px; }
.supplier-action-grid a { display: flex; align-items: center; gap: 11px; padding: 15px; color: var(--ink); background: var(--white); border: 1px solid var(--border); }
.supplier-action-grid a:hover { border-color: var(--navy-700); box-shadow: var(--shadow); }
.supplier-action-grid a > span { display: grid; width: 30px; height: 30px; place-items: center; color: var(--navy-700); background: var(--blue-100); border-radius: 4px; }
.supplier-action-grid div { display: grid; flex: 1; }
.supplier-action-grid strong { font-size: 12px; }
.supplier-action-grid small { margin-top: 3px; color: var(--muted); font-size: 10px; }
.supplier-action-grid b { color: var(--navy-700); }
.supplier-dashboard-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 18px; margin-bottom: 18px; }
.supplier-panel { padding: 20px; background: var(--white); border: 1px solid var(--border); }
.supplier-panel-heading { display: flex; align-items: end; justify-content: space-between; gap: 15px; margin-bottom: 18px; }
.supplier-panel-heading .eyebrow { margin-bottom: 3px; }
.supplier-panel-heading h2 { margin: 0; color: var(--navy-950); font-size: 17px; }
.supplier-panel-heading > a { color: var(--navy-700); font-size: 11px; font-weight: 700; }
.supplier-quote-list article, .supplier-product-list article { display: flex; align-items: center; gap: 10px; padding: 11px 0; border-bottom: 1px solid #edf1f5; }
.quote-avatar { display: grid; width: 31px; height: 31px; flex-shrink: 0; place-items: center; color: var(--navy-700); background: var(--blue-100); border-radius: 50%; font-size: 11px; font-weight: 700; }
.supplier-quote-list article > div, .supplier-product-list article > div { display: grid; min-width: 0; flex: 1; }
.supplier-quote-list strong, .supplier-product-list strong { overflow: hidden; color: var(--navy-950); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
.supplier-quote-list small, .supplier-product-list small { overflow: hidden; color: var(--muted); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.supplier-status { padding: 4px 7px; border-radius: 3px; color: var(--navy-700); background: var(--blue-100); font-size: 9px; font-weight: 700; white-space: nowrap; }
.supplier-status-pending, .supplier-status-negotiating { color: #8a5a00; background: #fff5d9; }
.supplier-status-paid, .supplier-status-completed, .supplier-status-active { color: #176447; background: #eaf8f0; }
.supplier-status-cancelled { color: #8b2635; background: #fff0f1; }
.supplier-orders-panel { margin-bottom: 0; }
.supplier-order-table { overflow-x: auto; }
.supplier-order-table table { width: 100%; min-width: 560px; border-collapse: collapse; font-size: 11px; }
.supplier-order-table th { color: var(--muted); background: var(--blue-50); text-align: left; text-transform: uppercase; }
.supplier-order-table th, .supplier-order-table td { padding: 11px 10px; border-bottom: 1px solid #edf1f5; }
.supplier-order-table td strong { color: var(--navy-950); }
@media (max-width: 900px) { .supplier-shell { grid-template-columns: 1fr; } .supplier-sidebar { order: 1; } .supplier-workspace { order: 0; } .supplier-kpis { grid-template-columns: repeat(2, 1fr); } .supplier-dashboard-grid { grid-template-columns: 1fr; } }
@media (max-width: 600px) { .supplier-topbar-inner { align-items: flex-start; flex-direction: column; gap: 12px; padding: 16px 0; } .supplier-welcome { align-items: flex-start; flex-direction: column; } .supplier-action-grid { grid-template-columns: 1fr; } .supplier-kpis { gap: 8px; } .supplier-kpis article { padding: 12px; } .supplier-kpis strong { font-size: 19px; } }